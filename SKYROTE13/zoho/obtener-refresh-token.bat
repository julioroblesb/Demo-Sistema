@echo off
chcp 65001 >nul
title Nexo - Refresh token Zoho Mail
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { Write-Host 'NEXO - Obtener refresh token de Zoho Mail' -ForegroundColor Green; $code=Read-Host '1) Pega el codigo temporal de Zoho'; $clientId=Read-Host '2) Pega el Client ID'; $clientSecret=Read-Host '3) Pega el Client Secret'; if([string]::IsNullOrWhiteSpace($code)-or[string]::IsNullOrWhiteSpace($clientId)-or[string]::IsNullOrWhiteSpace($clientSecret)){throw 'Falta uno de los tres valores.'}; $response=Invoke-RestMethod -Method Post -Uri 'https://accounts.zoho.com/oauth/v2/token' -Body @{code=$code.Trim();client_id=$clientId.Trim();client_secret=$clientSecret.Trim();grant_type='authorization_code'}; if(-not $response.refresh_token){throw ('Zoho no devolvio refresh_token: '+($response|ConvertTo-Json -Compress))}; Set-Clipboard -Value ([string]$response.refresh_token); Write-Host ''; Write-Host 'LISTO: refresh token copiado al portapapeles.' -ForegroundColor Green; Write-Host 'Pegalo en Supabase como ZOHO_REFRESH_TOKEN.' } catch { Write-Host ''; Write-Host ('ERROR: '+$_.Exception.Message) -ForegroundColor Red }; Read-Host 'Pulsa Enter para cerrar'"
